{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ruvelo/changelog-entry",
    "version": "1.0.0",
    "title": "Changelog Entry",
    "category": "widgets",
    "icon": "megaphone",
    "description": "One changelog entry. Used by the single entry template.",
    "keywords": [],
    "textdomain": "ruvelo-feedback",
    "attributes": {
        "align": {
            "type": "string",
            "default": "wide"
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "spacing": {
            "margin": true,
            "padding": true
        },
        "inserter": false
    },
    "editorScript": "ruvelo-feedback-blocks",
    "style": "ruvelo-feedback",
    "viewScript": "ruvelo-feedback",
    "render": "file:./render.php",
    "usesContext": [
        "postId",
        "postType"
    ]
}
