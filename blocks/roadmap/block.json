{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ruvelo/roadmap",
    "version": "1.0.0",
    "title": "Roadmap",
    "category": "widgets",
    "icon": "columns",
    "description": "Planned, in progress and shipped requests, as columns with their votes.",
    "keywords": [
        "roadmap",
        "planned",
        "feedback"
    ],
    "textdomain": "ruvelo-feedback",
    "attributes": {
        "limit": {
            "type": "number",
            "default": 20
        },
        "showNav": {
            "type": "boolean",
            "default": true
        },
        "showHeading": {
            "type": "boolean",
            "default": true
        },
        "align": {
            "type": "string",
            "default": "wide"
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "spacing": {
            "margin": true,
            "padding": true
        },
        "inserter": true
    },
    "editorScript": "ruvelo-feedback-blocks",
    "style": "ruvelo-feedback",
    "viewScript": "ruvelo-feedback",
    "render": "file:./render.php",
    "styles": [
        {
            "name": "default",
            "label": "Ruvelo",
            "isDefault": true
        },
        {
            "name": "theme",
            "label": "Match theme"
        }
    ]
}
